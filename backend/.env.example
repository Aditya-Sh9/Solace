# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database (Supabase connection string)
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# Supabase Auth (token verification via supabase.auth.getUser — NOT HS256/JWT secret)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI
GEMINI_API_KEY=your-gemini-api-key
# Optional. Primary Gemini model; defaults to gemini-3.8-flash (falls back to gemini-flash-lite-latest).
# Google retires models regularly - change this here instead of redeploying code.
# GEMINI_MODEL=gemini-3.8-flash

# ML Service
ML_SERVICE_URL=http://localhost:8000
